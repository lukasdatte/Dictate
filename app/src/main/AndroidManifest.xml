<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Windows-Dispatch pairing (ADR-0017): the QR scanner is a COMFORT path, not a
         requirement — manual URL + code entry is fully equivalent. required=false keeps the
         app installable on camera-less devices; the permission is requested at runtime, and
         only when the user taps "Scan QR". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Block 2 (DictatePipelineService — see Spec 1 §11.1.1):
          FOREGROUND_SERVICE           mandatory for any FGS on API ≥ 28
          FOREGROUND_SERVICE_MICROPHONE mandatory on API ≥ 34 because
                                        foregroundServiceType="microphone"
          POST_NOTIFICATIONS           mandatory on API ≥ 33 for the
                                        persistent FGS notification. Runtime
                                        prompt: OnboardingAdapter position 1
                                        (first-run) + DictateSettingsActivity
                                        fallback, gated by
                                        NotificationPermissionPolicy (F-092).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        B1.4 (FGS Crash-Resilience): BootCompletedReceiver runs a
        DB-only recovery pass after a reboot, so stale RECORDING /
        TRANSCRIBING rows are promoted before the user opens the
        keyboard the first time.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        TODO(Block 6): keyboard-floating overlay (Spec 3 §5.7).
        Pre-declared here so the manifest is touched only once across blocks;
        no-op until Block 6 wires the overlay window.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".DictateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dictate"
        tools:targetApi="31">

        <service
            android:name=".core.DictateInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            Block 2: DictatePipelineService (Foreground Service, ADR-0003).
            Hosts the pipeline orchestrator (added in Block 1b) and survives
            keyboard switches. exported=false because all clients are
            in-process via LocalBinder (Spec 1 §5).
        -->
        <service
            android:name=".core.DictatePipelineService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:description="@string/dictate_pipeline_service_description" />

        <!--
            B1.4 (FGS Crash-Resilience): runs PipelineRecovery.recoverDbOnly()
            after device boot so stale recording / transcribing rows are
            cleaned up before the keyboard is first opened. exported=false:
            only the system sends ACTION_BOOT_COMPLETED.
        -->
        <receiver
            android:name=".core.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".settings.DictateSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                External dictation entry points (2026-07-09): static
                "Dictation" app shortcut (long-press on the launcher
                icon, pinnable). Attached to the main launcher activity;
                the alias below is itself the dictation trigger, so it
                carries no shortcut of its own.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            External dictation entry points (2026-07-09, see
            docs/research/2026-07-09 - external-dictation-entry-points.md):
            invisible trampoline that funnels ALL external triggers
            (launcher alias / app shortcut / QS tile) into the single
            canonical service action ACTION_START_DICTATION.

            Theme.NoDisplay ⇒ the activity draws nothing and must
            finish() in onCreate. noHistory + excludeFromRecents +
            taskAffinity="" keep the trigger out of recents and prevent
            it from pulling the main Dictate task to the foreground.

            exported=true: the alias requires it, and it lets automation
            tools (Tasker, Samsung Routines) fire the trigger directly
            via the explicit intent-filter action.
        -->
        <activity
            android:name=".core.StartDictationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:icon="@mipmap/ic_dictation"
            android:label="@string/start_dictation_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="net.devemperor.dictate.START_DICTATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Second launcher entry "Dictation" — this is what S-Pen Air
            Command, the Samsung Edge panel, the side-key double-press
            picker, and similar app pickers list (they enumerate
            MAIN+LAUNCHER components). The main app entry above stays
            untouched. android:enabled defaults to true; never rename
            this component — launchers drop pinned shortcuts/positions
            for renamed aliases.
        -->
        <activity-alias
            android:name=".core.StartDictation"
            android:exported="true"
            android:icon="@mipmap/ic_dictation"
            android:label="@string/start_dictation_label"
            android:targetActivity=".core.StartDictationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Quick-Settings tile "Dictation" (third external trigger; same
            StartDictationActivity funnel). BIND_QUICK_SETTINGS_TILE is
            mandatory — without it the system never binds the tile.
        -->
        <service
            android:name=".core.DictationTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_dictation"
            android:label="@string/start_dictation_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!--
            Block 5 / Spec 3 §5.2 — standalone onboarding screen for the
            floating-overlay (SYSTEM_ALERT_WINDOW) permission. Primary
            onboarding surface is the in-IME info-bar (§5.3); this
            Activity covers secondary entry-points (deep-link,
            notification action, manual launch for tests).
        -->
        <activity
            android:name=".onboarding.OverlayPermissionOnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".rewording.PromptEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".rewording.PromptsOverviewActivity" />
        </activity>
        <activity
            android:name=".rewording.PromptsOverviewActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".usage.UsageActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".settings.SystemPromptsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".settings.APISettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".settings.WindowsPairingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".settings.HowToActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".history.HistoryActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".settings.DictateSettingsActivity" />
        </activity>
        <activity
            android:name=".history.HistoryDetailActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".history.HistoryActivity" />
        </activity>
    </application>

</manifest>
