<?xml version="1.0" encoding="utf-8"?>
<!-- Entity-based API settings hub (C3, spec §10): provider list + profile list.
     Rows are inflated programmatically by APISettingsActivity (item_config_row.xml). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_api_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/api_settings_providers_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_providers"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/dictate_blue" />

        <LinearLayout
            android:id="@+id/api_settings_provider_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/api_settings_add_provider_btn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_add_provider" />

        <TextView
            android:id="@+id/api_settings_profiles_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_profiles"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/dictate_blue" />

        <LinearLayout
            android:id="@+id/api_settings_profile_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/api_settings_add_profile_btn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_add_profile" />

    </LinearLayout>
</ScrollView>
