<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dictate_keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/dictate_keyboard_background_light">

    <!-- ════════════════════════════════════════════════════════════
         Main button area — MotionLayout-rooted, flat button hierarchy.

         See: docs/plans/2026-05-07 - dictate-keyboard-layout-refactor/
              research/2-keyboard-layout/2-keyboard-layout.reviewed.md §7.2
              docs/decisions/0004-ui-layout-catalog-motionlayout.md §3

         The old vertical LinearLayout + two nested ConstraintLayouts
         (action_row / input_row) are gone (Spec 2 §11.1). All nine buttons
         are now direct children of the MotionLayout; their positions live
         in res/xml/motion_scene_keyboard.xml, NOT here. The only constraints
         in this file are the MotionLayout's own placement inside the parent
         ConstraintLayout.

         Visibility is owned by LayoutCatalog (ADR-0004 §3 / Spec 2 §7.3) —
         every state-driven button keeps an initial android:visibility hint
         (so the layout-preview is sane) but MotionScene PropertySet entries
         set visibilityMode="ignore" on each, so Catalog predicates win at
         render time.
         ════════════════════════════════════════════════════════════ -->
    <!-- Post-cutover hotfix (R1) — paddingBottom restores the bottom safe-area
         the legacy `input_row.layout_marginBottom="16dp"` provided (Spec 2 §11.1
         deleted the container without rebuilding the spacing). Without it, the
         Row-2 chain (trash/space/pause/enter) sits flush against the keyboard's
         bottom edge → gets pushed under the gesture-nav bezel on modern devices.
         Row-1 ↔ Row-2 inter-row gap is restored on trash_btn's layout_marginTop
         in motion_scene_keyboard.xml two_row_state. -->
    <!-- Post-cutover hotfix #R1-DEEP3 — `app:currentState` MUST be set
         declaratively. The Row-2 buttons (`trash_btn`, `space_btn`,
         `pause_btn`, `enter_btn`) have NO inline child constraints in this
         XML; their `Top_toBottomOf=record_pulse_layout` chain lives only
         in `motion_scene_keyboard.xml` `two_row_state`. Without
         `app:currentState`, MotionLayout's internal `mModel` is empty
         until the first `onMeasure` — and `motionSurface.jumpToState(...)`
         called from `ImeViewBackend.render(firstRender=true)` runs BEFORE
         `onAttachedToWindow`, so it merely stamps `mCurrentState=id`
         without populating constraints. ConstraintLayout then falls back
         to placing every unconstrained child at position (0, 0), so
         `trash_btn` lands directly on top of `record_pulse_layout` (the
         "Row 1 ↔ Row 2 overlap on boot" symptom). Recording later
         triggers `requestLayout()` via `BorderGlowAnimation.start()`
         (foreground/background/text writes on `record_btn`), forcing
         `onMeasure`, populating `mModel` from `two_row_state`, and
         snapping the layout into the correct geometry — that is why
         "starting a recording fixes it" but a cold boot does not.
         Setting `app:currentState` makes `mModel` populate on the FIRST
         measure pass — the layout is correct from frame zero. -->
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/main_buttons_cl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="72dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layoutDescription="@xml/motion_scene_keyboard"
        app:currentState="@+id/two_row_state"
        app:layout_constraintTop_toBottomOf="@id/edit_buttons_keyboard_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- record_pulse_layout — PulseLayout wrapper around record_btn (L7).
             The wrapper is the direct MotionLayout child; record_btn lives
             inside it.

             Post-cutover hotfix #R1-DEEP2 — the inline `layout_marginBottom`
             here is the **boot-state** anchor for the Row 1 ↔ Row 2 16dp
             gap. MotionLayout only applies its ConstraintSet margins after
             the first `transitionToState`; before that, the inline XML
             LayoutParams are authoritative. Without this attribute the
             very first render of Idle has 0dp gap and only later
             transitions (Idle → Recording → Idle, or Send → Idle) pick up
             the 16dp from `motion_scene_keyboard.xml` `two_row_state`. The
             value is duplicated intentionally: the MotionScene carries
             the same 16dp on `record_pulse_layout.marginBottom` in
             `two_row_state` (and derived states inherit) — keeping the
             two values identical is the simplest way to make the boot
             frame look the same as every subsequent transition frame. -->
        <net.devemperor.dictate.widget.PulseLayout
            android:id="@+id/record_pulse_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:pulseCount="3"
            app:pulseDuration="2000"
            app:pulseStartAlpha="0.3"
            app:pulseMaxRadiusFactor="1.4"
            app:pulseStyle="fill">

            <!-- B4-VAL F-29: catalog overrides android:text at render-time
                 via ButtonSlot.textResolver — the per-mode label resolves
                 from LayoutCatalog.KEYBOARD_*_RECORD slots (Spec 2 §8.5).
                 The static text here is the inflation fallback.

                 B-D-1 (dictate-pipeline-render-and-state-unification §5.1
                 + §9.1 OQ-1 Variante A): `maxLines="2"` lets the
                 pipeline-phase label render as two lines —
                 `<stepName>\n<N>/<M> M:SS` (step name above counter).
                 The Idle/Active/Paused labels remain single-line; the
                 button height grows only during Running, which the
                 wrap_content layout absorbs. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dictate_record"
                android:textSize="14sp"
                android:maxLines="2" />

        </net.devemperor.dictate.widget.PulseLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resend_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_outline_change_circle_24"
            android:foregroundGravity="center"
            android:minWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backspace_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_baseline_keyboard_backspace_24"
            android:foregroundGravity="center"
            android:minWidth="56dp" />

        <!-- widget_toggle_btn — opens the floating WIDGET overlay (Spec 3
             OPEN-2 / Phase-1-1.0.2). Catalog hides it during pipeline /
             reprocess-staging; position lives in MotionScene. Placeholder
             icon (change_circle) until B5 ships a dedicated drawable.
             B4-VAL F-29: catalog overrides android:foreground via
             ButtonSlot.iconResolver — see LogicalButtonId.WIDGET_TOGGLE
             slot definitions (Spec 2 §8.1 / §8.2). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/widget_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_outline_change_circle_24"
            android:foregroundGravity="center"
            android:minWidth="56dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audio_focus_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_baseline_volume_off_24"
            android:foregroundGravity="center"
            android:minWidth="56dp"
            android:visibility="gone"
            tools:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trash_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_baseline_delete_24"
            android:foregroundGravity="center"
            android:minWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/space_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <!-- pause_btn — DO NOT add android:foreground here. The pause/mic
             icon flip is owned by the catalog `iconResolver = ::resolvePauseIcon`
             (LayoutCatalog.kt:146 / :197 / :578) and written by
             SlotRenderer.applySlotToView via MaterialButton.icon — the single
             writer. A static `android:foreground` would render on top of the
             dynamic icon (Android draws foreground over MaterialButton.icon),
             producing the B-B duplication bug
             (see docs/plans/2026-05-21 - dictate-pipeline-render-and-state-unification §4.2). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enter_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ic_baseline_subdirectory_arrow_left_24"
            android:foregroundGravity="center"
            android:minWidth="56dp" />

    </androidx.constraintlayout.motion.widget.MotionLayout>

    <!-- C15 — Removed `action_row` / `input_row` scaffold stubs
         (C13 deviation). The KeyboardLayoutModeController + all
         remaining legacy `findViewById(R.id.action_row|input_row)`
         resolution sites were deleted in Spec 2 §11.8 5d. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/info_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="@string/dictate_internet_error_msg"
            android:textColor="@color/dictate_red"
            android:textSize="16sp"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/info_yes_btn"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/info_yes_btn"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:foreground="@drawable/ic_baseline_check_circle_outline_24"
            android:foregroundGravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/info_no_btn"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/info_tv"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <Button
            android:id="@+id/info_no_btn"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:foreground="@drawable/ic_baseline_not_interested_24"
            android:foregroundGravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/info_yes_btn"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ════════════════════════════════════════════════════════════
         Overlay-permission onboarding info-bar (Spec 3 §5.3, B5 F-2).

         Surfaced above the keyboard buttons when the user taps the
         WIDGET_TOGGLE without SYSTEM_ALERT_WINDOW permission
         (resolveWidgetToggleAction → ShowOverlayOnboarding →
         state.overlay.onboardingPending = true). Bound + visibility-
         toggled from the IME service's pipeline-state observation
         (DictateInputMethodService), co-located with the existing
         InfoBarController surface — see ADR-0005 Decision-History
         2026-05-15.

         Z-order fix (2026-05-22): this container is the live render
         target of the state-driven InfoBarRenderer — not just the
         first-run overlay-permission flow. It is therefore chained
         INTO the vertical layout (`Top_toBottomOf=info_cl`, with
         prompts_keyboard_cl chained below it) so a shown InfoBar
         pushes the keyboard content down instead of floating over —
         and behind — it. Before the fix it floated at parent-top and
         was drawn underneath the later-declared button rows. info_cl
         stays the legacy-InfoBarController container; the two now
         stack cleanly if both ever show simultaneously.
         ════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay_permission_infobar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/info_cl"
        tools:visibility="visible">

        <TextView
            android:id="@+id/overlay_permission_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="@string/overlay_perm_explainer"
            android:textColor="@color/dictate_blue"
            android:textSize="16sp"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/overlay_perm_grant_btn"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/overlay_perm_grant_btn"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:foreground="@drawable/ic_baseline_check_circle_outline_24"
            android:foregroundGravity="center"
            android:contentDescription="@string/overlay_perm_grant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/overlay_perm_dismiss_btn"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/overlay_permission_message"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/overlay_perm_dismiss_btn"
            style="@style/Widget.AppCompat.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:foreground="@drawable/ic_baseline_not_interested_24"
            android:foregroundGravity="center"
            android:contentDescription="@string/overlay_perm_later"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/overlay_perm_grant_btn"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_buttons_keyboard_ll"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/prompts_keyboard_cl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_undo_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            android:foreground="@drawable/ic_baseline_undo_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_redo_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_redo_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_redo_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_cut_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_undo_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_cut_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_content_cut_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_copy_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_redo_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_copy_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_content_copy_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_paste_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_cut_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_paste_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_content_paste_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_emoji_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_copy_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_emoji_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:foreground="@drawable/ic_baseline_emoji_emotions_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_keyboard_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_paste_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_keyboard_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_numbers_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_history_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_emoji_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_history_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_history_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_audio_focus_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_keyboard_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Block 2: audio-focus toggle (Edit-Bar variant). Always visible,
             foreground icon + contentDescription are flipped at runtime via
             MainButtonsController.refreshAudioFocusIcon(enabled). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_audio_focus_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_volume_off_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_settings_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_history_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_settings_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_settings_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_numbers_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_audio_focus_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- edit_numbers_btn — SmallMode-Toggle (Click: EditBarController
             onSmallModeToggled, Long-press: onSingleRowModeToggled).
             Relocated 2026-05-22 from its old position between emoji + keyboard
             to the right edge of the bar, between settings and widget-toggle
             (user-requested ordering). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_numbers_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:foreground="@drawable/ic_baseline_keyboard_arrow_down_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/edit_widget_toggle_btn"
            app:layout_constraintStart_toEndOf="@+id/edit_settings_btn"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- edit_widget_toggle_btn — relocated 2026-05-22 from the main
             action row (motion_scene_keyboard.xml widget_toggle_btn) into
             the edit-bar. The main-row view stays in place as a GONE
             structural placeholder (LayoutCatalog WIDGET_TOGGLE slot now
             returns visibilityPredicate { false } in TWO_ROW + SINGLE_ROW).
             Click handler bound by EditBarController.onWidgetToggleClicked. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_widget_toggle_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:foreground="@drawable/ic_outline_change_circle_24"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/edit_numbers_btn"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prompts_keyboard_cl"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/overlay_permission_infobar"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/prompt_recording_controls_ll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prompt_rec_indicator_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prompt_pause_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:foreground="@drawable/ic_baseline_pause_24"
                android:foregroundGravity="center"
                android:minWidth="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prompt_trash_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="@drawable/ic_baseline_delete_24"
                android:foregroundGravity="center"
                android:minWidth="36dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/prompts_keyboard_rv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="12dp"
            app:layout_goneMarginStart="12dp"
            android:scrollbars="horizontal"
            android:scrollbarSize="1dp"
            app:layout_constraintStart_toEndOf="@id/prompt_recording_controls_ll"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:layout_height="32dp" />

        <include
            layout="@layout/pipeline_progress_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emoji_picker_cl"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:background="@color/dictate_keyboard_background_light"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/emoji_picker_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/dictate_emoji_picker_title"
            android:textColor="@color/dictate_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/emoji_picker_close_btn"
            app:layout_constraintEnd_toStartOf="@+id/emoji_picker_close_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/emoji_picker_close_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emoji_picker_close_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:foreground="@drawable/ic_baseline_close_24"
            android:foregroundGravity="center"
            android:minWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emoji_picker_close_btn" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/qwertz_keyboard_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_buttons_keyboard_ll"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay_characters_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/main_buttons_cl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_buttons_cl"
        tools:visibility="visible"
        tools:layout_width="72dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
