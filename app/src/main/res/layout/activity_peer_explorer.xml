<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only Peer Explorer (Block E3, peer-katalog.md §8.3): groups of copies per source peer.
     Rows are plain TextViews added programmatically by PeerExplorerActivity — the page is a
     read-only report, not an editor (Android offers nothing and manages nothing, F7). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_peer_explorer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/peer_explorer_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dictate_peer_explorer_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:id="@+id/peer_explorer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/peer_explorer_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dictate_peer_explorer_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
