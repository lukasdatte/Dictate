<?xml version="1.0" encoding="utf-8"?>
<!-- Profile editor (C3, spec §10.3): name, model refs, prompt order, style/system prompt,
     ambiguity mode, completion parameter overrides. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_profile_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_profile_name"
            android:textColor="@color/dictate_blue" />

        <EditText
            android:id="@+id/profile_edit_name_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dictate_config_profile_name"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_transcription_model"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/profile_edit_transcription_model_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_completion_model"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/profile_edit_completion_model_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_style_prompt"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/profile_edit_style_prompt_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/profile_edit_style_prompt_custom_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dictate_config_custom_prompt_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_system_prompt"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/profile_edit_system_prompt_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/profile_edit_system_prompt_custom_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dictate_config_custom_prompt_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_ambiguity_mode"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/profile_edit_ambiguity_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_profile_prompts"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/dictate_blue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_profile_prompts_help"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/profile_edit_prompt_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_parameter_overrides"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/dictate_blue" />

        <LinearLayout
            android:id="@+id/profile_edit_parameter_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_edit_save_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_save" />

    </LinearLayout>
</ScrollView>
