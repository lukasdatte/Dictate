<?xml version="1.0" encoding="utf-8"?>
<!-- Provider editor (C3, spec §10.1/§10.2): type, label, base URL (CUSTOM), credential, model refs. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_provider_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_provider_type"
            android:textColor="@color/dictate_blue" />

        <Spinner
            android:id="@+id/provider_edit_type_spn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_provider_label"
            android:textColor="@color/dictate_blue" />

        <EditText
            android:id="@+id/provider_edit_label_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dictate_config_provider_label"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:id="@+id/provider_edit_base_url_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dictate_config_provider_base_url"
                android:textColor="@color/dictate_blue" />

            <EditText
                android:id="@+id/provider_edit_base_url_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dictate_config_provider_base_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dictate_config_api_key"
            android:textColor="@color/dictate_blue" />

        <EditText
            android:id="@+id/provider_edit_api_key_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dictate_config_api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/provider_edit_key_status_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_models"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/dictate_blue" />

        <LinearLayout
            android:id="@+id/provider_edit_model_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/provider_edit_add_model_btn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_config_add_model" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/provider_edit_save_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dictate_config_save" />

    </LinearLayout>
</ScrollView>
