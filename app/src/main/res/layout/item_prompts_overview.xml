<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_prompts_overview_card"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/item_prompts_overview_drag_handle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/dictate_prompts_reorder"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_drag_indicator_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/item_prompts_overview_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/item_prompts_overview_icons_container"
            app:layout_constraintStart_toEndOf="@id/item_prompts_overview_drag_handle"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Translator French" />

        <LinearLayout
            android:id="@+id/item_prompts_overview_icons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/item_prompts_overview_name_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/item_prompts_overview_name_tv">

            <ImageView
                android:id="@+id/item_prompts_overview_requires_selection_iv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/dictate_requires_selection"
                android:src="@drawable/ic_baseline_select_all_24" />

            <ImageView
                android:id="@+id/item_prompts_overview_auto_apply_iv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/dictate_auto_apply"
                android:src="@drawable/ic_baseline_autorenew_24" />

            <!-- C3 §10.6: origin badge — visible only for peer-sourced prompts. -->
            <TextView
                android:id="@+id/item_prompts_overview_origin_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/dictate_config_origin_peer"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/dictate_blue"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/item_prompts_overview_type_iv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/dictate_prompt_type_text"
                android:src="@drawable/ic_baseline_content_paste_24"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/item_prompts_overview_prompt_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/item_prompts_overview_name_tv"
            app:layout_constraintTop_toBottomOf="@id/item_prompts_overview_name_tv"
            tools:text="Translate the following text into French. Use exactly the same style and language as in the original text." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_prompts_overview_duplicate_btn"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/dictate_prompts_duplicate"
            app:icon="@drawable/ic_baseline_content_copy_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/item_prompts_overview_delete_btn"
            app:layout_constraintTop_toBottomOf="@id/item_prompts_overview_prompt_tv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_prompts_overview_delete_btn"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/dictate_prompts_delete"
            app:icon="@drawable/ic_baseline_delete_24"
            app:iconTint="?attr/colorError"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/item_prompts_overview_prompt_tv" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
