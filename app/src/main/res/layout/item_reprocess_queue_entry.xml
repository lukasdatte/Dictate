<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/reprocess_queue_entry_drag_handle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/dictate_reprocess_queue_drag_handle"
        android:src="@drawable/ic_baseline_drag_indicator_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reprocess_queue_entry_name_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="French Translator" />

        <TextView
            android:id="@+id/reprocess_queue_entry_preview_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Translate the following text into French..." />

    </LinearLayout>

    <ImageButton
        android:id="@+id/reprocess_queue_entry_remove_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dictate_reprocess_queue_remove"
        android:src="@drawable/ic_baseline_close_24"
        android:tint="?android:attr/textColorSecondary" />

</LinearLayout>
