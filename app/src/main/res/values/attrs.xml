<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-defined semantic warning color (light + night values in colors.xml).
         M3 has no built-in warning role, so history's downstream-staleness
         warning resolves its color through this attr (ADR-0010 point 4). -->
    <attr name="dictateColorWarning" format="color" />

    <!-- App-defined PC-send-mode color (light + night values in colors.xml).
         M3 has no role for "this output is routed somewhere else", so the
         PC-mode signal resolves its color through this attr (ADR-0010 point 4).
         The keyboard's own consumers (record button, edit-bar PC button) read
         @color/dictate_pc_mode directly instead — they paint programmatically,
         which ADR-0010 exempts, and resource qualifiers already give them the
         night variant without a theme lookup. -->
    <attr name="dictateColorPcMode" format="color" />

    <declare-styleable name="PulseLayout">
        <attr name="pulseCount" format="integer" />
        <attr name="pulseDuration" format="integer" />
        <attr name="pulseColor" format="color" />
        <attr name="pulseMaxRadiusFactor" format="float" />
        <attr name="pulseStartAlpha" format="float" />
        <attr name="pulseStrokeWidth" format="float" />
        <attr name="pulseStyle" format="enum">
            <enum name="fill" value="0" />
            <enum name="stroke" value="1" />
        </attr>
    </declare-styleable>
</resources>
