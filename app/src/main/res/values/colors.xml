    <!--    Material 600-->
    <color name="dictate_blue_dark">#1C7EAB</color>

    <color name="dictate_white">#ffffff</color>
    <color name="dictate_black">#000000</color>
    <color name="dictate_grey">#A8A8A8</color>
    <color name="dictate_red">#E53935</color>
    <color name="dictate_green">#43A047</color>

    <color name="dictate_keyboard_background_dark">#1b1b1d</color>
    <color name="dictate_keyboard_background_light">#f1f1f1</color>

    <!-- Semantic warning (amber). Light value; dark override in values-night.
         Contrast-checked against colorSurface in both modes. -->
    <color name="dictate_warning">#B26A00</color>

    <!--
      PC send-mode (ADR-0019). The record button breathes this colour instead of
      the accent while a dictation is routed to the paired PC, so "where does
      this text land" is answered before the user speaks rather than after.

      Deliberately NOT derived from the accent: the accent is user-configurable
      (Pref.AccentColor), so an accent-derived signal would vanish for anyone
      who already picked purple. A fixed hue is the only way the signal always
      reads as "different from normal".

      Night value in values-night/colors.xml. Contrast-checked against both
      keyboard backgrounds with white button text.
    -->
    <color name="dictate_pc_mode">#7E57C2</color>
    <!-- pc-dictation-activity: failure banner background (send-to-PC error surface). -->
    <color name="dictate_error_banner_bg">#C62828</color>
</resources>