<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      In-keyboard history panel (ADR-0014) — default list height. Overridden at
      runtime by the IME to ~50% of the display height, clamped to
      [dictate_history_panel_list_min, dictate_history_panel_list_max], so the
      panel is "distinctly taller" than the button grid across device sizes.
      This static value is the pre-measurement fallback.
    -->
    <dimen name="dictate_history_panel_list_height">320dp</dimen>
    <dimen name="dictate_history_panel_list_min">280dp</dimen>
    <dimen name="dictate_history_panel_list_max">400dp</dimen>

    <!--
      Drag-to-resize (Block A). The user can drag the grab handle at the bottom of
      the history panel to change the list height. Bounds are deliberately more
      generous than the auto-default clamp above: a fixed lower bound and a dynamic
      upper bound of 60 % of the display height (computed at runtime, not a dimen,
      so it tracks the current screen / split-screen size).
    -->
    <dimen name="dictate_history_panel_drag_min">200dp</dimen>
    <dimen name="dictate_history_panel_handle_height">24dp</dimen>

    <!--
      In-keyboard review panel (ADR-0013 / Block D). The panel owns its height
      (wrap_content) instead of borrowing it from the mode-emptied button grid.
      `min` guarantees a usable surface even for a tiny output; the output scroll
      is capped at `output_max` so a very long output scrolls within a bounded
      region rather than blowing up the IME window.
    -->
    <dimen name="dictate_review_panel_min">120dp</dimen>
    <dimen name="dictate_review_panel_output_max">240dp</dimen>
</resources>
