<?xml version="1.0" encoding="utf-8"?>
<!--
    Resource-id declarations for runtime-only View tags.

    These ids do NOT correspond to physical Views in any layout — they are
    keys for `View.setTag(int, Object)` / `getTag(int)` so multiple
    independent callers can attach their own per-View state without
    colliding (each declared key is a globally-unique tag namespace).

    Spec  : Spec 2 §11.5 — per-tick allocation budget.
    Block : B4-VAL F-28 — SlotRenderer caches last-applied icon-res id
            per View to skip redundant `ContextCompat.getDrawable(...)`
            calls on state emits that don't actually flip the icon.
-->
<resources>

    <!-- SlotRenderer caches the last-applied @DrawableRes int per
         MaterialButton View under this key (B4-VAL F-28). -->
    <item name="slot_renderer_last_icon_res" type="id" />

    <!-- SlotRenderer caches the last-applied text CharSequence per
         MaterialButton View under this key (B4-VAL F-28). -->
    <item name="slot_renderer_last_text" type="id" />

</resources>
