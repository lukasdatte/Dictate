<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dictate" parent="Theme.Material3.Light">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dictate_blue</item>
        <item name="colorPrimaryVariant">@color/dictate_blue</item>
        <item name="colorOnPrimary">@color/dictate_black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dictate_blue</item>
        <item name="colorSecondaryVariant">@color/dictate_blue</item>
        <item name="colorOnSecondary">@color/dictate_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>

        <!-- App-defined warning color (dark override in values-night/themes.xml). -->
        <item name="dictateColorWarning">@color/dictate_warning</item>

        <!-- App-defined PC-send-mode color (dark override in values-night/themes.xml). -->
        <item name="dictateColorPcMode">@color/dictate_pc_mode</item>

        <!-- Customize your theme here. -->

    </style>

    <!-- Single style for all history step-card / status icon buttons.
         Icon color comes from the theme attr (?attr/colorOnSurfaceVariant), so
         it stays DayNight-correct regardless of the drawable's baked tint —
         per ADR-0010 (usage-site theme-attr tint). -->
    <style name="Widget.Dictate.HistoryIconButton" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
