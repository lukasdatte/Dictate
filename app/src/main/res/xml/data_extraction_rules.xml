<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+): cloud backup + device transfer.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          Exclude the SecretStore blob file (spec secretstore.md §5.3). The AES-GCM blobs are
          wrapped by a device-bound Keystore KEK that does not survive backup/transfer; restoring
          "dead" ciphertext without its key reads as corrupt (DecryptionFailed). Keys are re-entered
          on the new device — the accepted consequence recorded in adr-secret-store.
        -->
        <exclude domain="sharedpref" path="net.devemperor.dictate.secretstore.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="net.devemperor.dictate.secretstore.xml"/>
    </device-transfer>
</data-extraction-rules>
