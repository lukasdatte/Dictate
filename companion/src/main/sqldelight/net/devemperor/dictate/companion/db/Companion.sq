-- Schema of the companion's local history.
--
-- The phone is the authority for the sessions it dictated; those rows here are a derived copy
-- (ADR-0020). The file is expendable by design for that mirror: a wiped database makes the sync
-- cursor return null, and the phone resends its history from the beginning. That is what
-- "self-healing" means in practice. Desktop-dictated sessions (host_origin = 'DESKTOP_DICTATION',
-- Block D) are the exception — they originate here and have no upstream to resend them.
--
-- The Kotlin-typed columns (`AS SessionType`, `AS InsertionOutcome`, `AS kotlin.Boolean`) are half
-- of the Double-Enum rule from docs/DATABASE-PATTERNS.md; the CHECK constraints are the other half.
-- Without the CHECK, a typo in a mapper writes 'KEYBORD' into the column and nothing complains until
-- a reader crashes months later; with it, the write fails at the boundary where the bug is.
-- `CompanionSchemaParityTest` pins the two halves against each other, and `RoomParityReference`
-- pins the vocabularies against the Room originals in `:app` (desktop-host.md §3.2/§3.6).

CREATE TABLE devices (
    device_id    TEXT NOT NULL PRIMARY KEY,
    name         TEXT NOT NULL,
    -- SHA-256 of the device secret, lowercase hex. The secret itself is never stored (ADR-0017).
    secret_hash  TEXT NOT NULL,
    paired_at    INTEGER NOT NULL,
    last_seen_at INTEGER
);

-- ── Room-parity session model (F15, desktop-host.md §3) ─────────────────────────────────────
--
-- The four tables below are a 1:1 translation of Room schema v11 (app/schemas/.../11.json): same
-- columns, affinities, nullability, FKs and indices. The only companion-added column is
-- `sessions.host_origin` — the axis that separates the phone mirror from desktop dictation. The
-- Double-Enum CHECK vocabularies come from the Room migration CHECKs (the Room JSON carries none).

CREATE TABLE sessions (
    id                       TEXT NOT NULL PRIMARY KEY,
    type                     TEXT AS net.devemperor.dictate.companion.domain.session.SessionType NOT NULL
                             CHECK (type IN ('RECORDING','REWORDING','POST_PROCESSING')),
    created_at               INTEGER NOT NULL,
    target_app_package       TEXT,
    language                 TEXT,
    audio_file_path          TEXT,
    -- JSON array of segment paths, exactly as Room stores it (ADR-0007 rolling segments).
    audio_file_paths         TEXT NOT NULL DEFAULT '[]',
    audio_duration_seconds   INTEGER NOT NULL DEFAULT 0,
    parent_session_id        TEXT,
    status                   TEXT AS net.devemperor.dictate.companion.domain.session.SessionStatus NOT NULL
                             CHECK (status IN ('RECORDING','RECORDING_INTERRUPTED','RECORDED',
                                               'TRANSCRIBING','COMPLETED','FAILED','CANCELLED')),
    origin                   TEXT AS net.devemperor.dictate.companion.domain.session.SessionOrigin NOT NULL
                             CHECK (origin IN ('KEYBOARD','HISTORY_REPROCESS',
                                               'POST_PROCESSING','REVIEW_REFINEMENT')),
    queued_prompt_ids        TEXT,
    -- The AI error taxonomy is owned by :shared-ai (AIProviderException.ErrorType) — never redefined
    -- companion-side, or the error vocabulary would fork against the shared runners.
    last_error_type          TEXT AS net.devemperor.dictate.ai.AIProviderException.ErrorType
                             CHECK (last_error_type IS NULL OR last_error_type IN
                                    ('INVALID_API_KEY','RATE_LIMITED','MODEL_NOT_FOUND','BAD_REQUEST',
                                     'SERVER_ERROR','NETWORK_ERROR','CANCELLED','UNKNOWN')),
    last_error_message       TEXT,
    final_output_text        TEXT,
    input_text               TEXT,
    inserted_at              INTEGER,
    -- Companion-only axis (F16), NOT part of the Room parity.
    host_origin              TEXT AS net.devemperor.dictate.companion.domain.session.HostOrigin NOT NULL DEFAULT 'DESKTOP_DICTATION'
                             CHECK (host_origin IN ('PHONE_SYNC','DESKTOP_DICTATION')),
    FOREIGN KEY (parent_session_id) REFERENCES sessions(id) ON DELETE SET NULL
);
CREATE INDEX sessions_parent_session_id ON sessions(parent_session_id);
CREATE INDEX sessions_type              ON sessions(type);
CREATE INDEX sessions_created_at        ON sessions(created_at);
CREATE INDEX sessions_origin            ON sessions(origin);
CREATE INDEX sessions_status            ON sessions(status);
CREATE INDEX sessions_host_origin       ON sessions(host_origin);
-- The sync cursor axis. EXACTLY the ordering the cursor and the phone's `sessionsAfterCursor` page
-- along — parity between the two sides is the contract that keeps paging from skipping rows
-- (ADR-0020). Ex-`received_texts_cursor`, moved onto sessions by the received_texts ablation.
CREATE INDEX sessions_sync_cursor       ON sessions(created_at, id);

CREATE TABLE transcriptions (
    id                TEXT NOT NULL PRIMARY KEY,
    session_id        TEXT NOT NULL,
    version           INTEGER NOT NULL,
    is_current        INTEGER AS kotlin.Boolean NOT NULL,
    text              TEXT NOT NULL,
    model_used        TEXT NOT NULL,
    -- Open vocabulary (AIProvider.name / free text): a provider set is not finite, so no CHECK.
    provider          TEXT NOT NULL,
    prompt_tokens     INTEGER NOT NULL,
    completion_tokens INTEGER NOT NULL,
    duration_ms       INTEGER NOT NULL,
    created_at        INTEGER NOT NULL,
    FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE
);
CREATE INDEX transcriptions_session_id ON transcriptions(session_id);
CREATE UNIQUE INDEX transcriptions_session_id_version ON transcriptions(session_id, version);

CREATE TABLE processing_steps (
    id                        TEXT NOT NULL PRIMARY KEY,
    session_id                TEXT NOT NULL,
    step_type                 TEXT AS net.devemperor.dictate.companion.domain.session.StepType NOT NULL
                              CHECK (step_type IN ('AUTO_FORMAT','REWORDING','QUEUED_PROMPT','CONVERSATION_TURN')),
    chain_index               INTEGER NOT NULL,
    version                   INTEGER NOT NULL,
    is_current                INTEGER AS kotlin.Boolean NOT NULL,
    input_text                TEXT NOT NULL,
    output_text               TEXT,
    model_used                TEXT NOT NULL,
    -- Open vocabulary, like transcriptions.provider — no CHECK.
    provider                  TEXT NOT NULL,
    prompt_used               TEXT,
    prompt_entity_id          INTEGER,
    previous_step_id          TEXT,
    previous_transcription_id TEXT,
    source_session_id         TEXT,
    prompt_tokens             INTEGER NOT NULL,
    completion_tokens         INTEGER NOT NULL,
    duration_ms               INTEGER NOT NULL,
    -- Room has NO CHECK here (bare TEXT NOT NULL); the companion adds one — a strict improvement
    -- on a green field, every Room value stays valid (desktop-host.md §14 D3).
    status                    TEXT AS net.devemperor.dictate.companion.domain.session.StepStatus NOT NULL
                              CHECK (status IN ('SUCCESS','ERROR')),
    error_message             TEXT,
    created_at                INTEGER NOT NULL,
    assistant_message         TEXT,
    response_format           TEXT AS net.devemperor.dictate.companion.domain.session.ResponseFormatKind
                              CHECK (response_format IS NULL OR response_format IN
                                     ('JSON_SCHEMA','TOOL_USE','TEXT_FALLBACK')),
    FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE
);
CREATE INDEX processing_steps_session_id ON processing_steps(session_id);
CREATE UNIQUE INDEX processing_steps_session_id_chain_index_version ON processing_steps(session_id, chain_index, version);
CREATE INDEX processing_steps_previous_step_id ON processing_steps(previous_step_id);
CREATE INDEX processing_steps_previous_transcription_id ON processing_steps(previous_transcription_id);
CREATE INDEX processing_steps_source_session_id ON processing_steps(source_session_id);

CREATE TABLE conversation_messages (
    id         TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    turn_index INTEGER NOT NULL,
    seq        INTEGER NOT NULL,
    role       TEXT AS net.devemperor.dictate.companion.domain.session.MessageRole NOT NULL
               CHECK (role IN ('SYSTEM','USER','ASSISTANT')),
    content    TEXT NOT NULL,
    step_id    TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE,
    FOREIGN KEY (step_id) REFERENCES processing_steps(id) ON DELETE SET NULL
);
CREATE INDEX conversation_messages_session_id ON conversation_messages(session_id);
CREATE UNIQUE INDEX conversation_messages_session_id_seq ON conversation_messages(session_id, seq);
CREATE INDEX conversation_messages_step_id ON conversation_messages(step_id);

-- ── dispatch_state — the phone-sync side channel (desktop-host.md §3.4) ──────────────────────
--
-- The sync-specific facts that used to live on `received_texts` — which device sent a row, when it
-- last landed here, whether it was dispatched, and how the insertion went. Split off `sessions` so
-- the session table stays a clean Room parity (device_id/dispatched would otherwise pollute the
-- parity diff). 1:1 with a PHONE_SYNC session; desktop-dictated sessions have no row here.
CREATE TABLE dispatch_state (
    session_id   TEXT NOT NULL PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE,
    device_id    TEXT NOT NULL REFERENCES devices(device_id) ON DELETE CASCADE,
    -- PC time: when this row was last written here (ex-`received_texts.received_at`).
    received_at  INTEGER NOT NULL,
    -- 1 = arrived through /v1/dispatch, 0 = only mirrored by the sync. Never walks back (see upsert).
    dispatched   INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    last_outcome TEXT AS net.devemperor.dictate.companion.domain.model.InsertionOutcome
                 CHECK (last_outcome IS NULL OR last_outcome IN ('TYPED_CTRL_V','CLIPBOARD_ONLY','FAILED'))
);

CREATE TABLE settings (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Configurable command -> chord mapping for /v1/input (D6, §5.4). Double-Enum, like above:
-- `command` is a Kotlin `KeyCommand` AND a SQL CHECK; the modifier flags and `vk` carry their own
-- CHECKs so a bogus mapping fails at the write boundary, not at injection time. Seeded from
-- DefaultChords by the v1 -> v2 migration; a missing row falls back to DefaultChords in the repo.
CREATE TABLE key_command_chords (
    command TEXT AS net.devemperor.dictate.companion.domain.model.KeyCommand NOT NULL PRIMARY KEY
            CHECK (command IN ('BACKSPACE','ENTER','SPACE','CURSOR_LEFT','CURSOR_RIGHT','CURSOR_WORD_SELECT_BACK','CURSOR_WORD_SELECT_FORWARD','SELECT_ALL','CUT','COPY','PASTE','UNDO','REDO')),
    ctrl    INTEGER AS kotlin.Boolean NOT NULL CHECK (ctrl IN (0,1)),
    shift   INTEGER AS kotlin.Boolean NOT NULL CHECK (shift IN (0,1)),
    alt     INTEGER AS kotlin.Boolean NOT NULL CHECK (alt IN (0,1)),
    win     INTEGER AS kotlin.Boolean NOT NULL CHECK (win IN (0,1)),
    vk      INTEGER NOT NULL CHECK (vk BETWEEN 1 AND 254)
);

-- ── Shareable config-entity model (F22, D5.b) — the Companion mirror of the C2 Room tables ─────
--
-- The four config entities (provider/model/prompt/profile) plus a profile's ordered prompts. This is
-- the "Spiegel C2" of peer-katalog.md §5.2: identical columns, identical Double-Enum CHECK
-- vocabularies, and — deliberately — the SAME `:shared` enum SOURCE that C2 Room uses
-- (net.devemperor.dictate.shared.config.*), NOT a parallel `catalog.*Wire` copy. Reusing the config
-- enums is what makes "share one source so Android-Room and Companion-SQLDelight cannot drift"
-- (§5.2's stated goal) true by construction rather than by a second parity test over a duplicate enum.
-- Enum parity to C1 is pinned by `ConfigEntityCheckParityTest`; the CHECK is the SQL half of the
-- Double-Enum rule (docs/DATABASE-PATTERNS.md), the `AS <Enum>` column is the Kotlin half.
--
-- Provenance columns (`source_*`, `subscription_mode`, `visibility`) are populated by Block E's
-- catalog sync (F14); until then a locally created entity leaves `source_*` NULL and
-- `subscription_mode = 'LOCAL'` — harmless (Plan §3 D5.b). `api_credentials` is intentionally NOT
-- mirrored here (peer-katalog §5.2 / Plan D5.b list five tables, not six): desktop credential
-- handling is the SecretStore + catalog-delivery path (Block B/E), not a local plaintext-adjacent
-- mirror in D3's scope.
--
-- The §5.2 `FOREIGN KEY (source_peer_id) REFERENCES peers(...)` is deliberately OMITTED here: `peers`
-- is created by E1 (Migration 4.sqm, which runs AFTER D3 per the E1→D3 edge), and SQLDelight
-- validates FK target tables at compile time — a forward reference to a not-yet-defined table would
-- fail the build. The `source_peer_id` provenance column is still present (D5.b: "vollständig"); the
-- DB-level cascade is E1's to add (table-recreate) once `peers` exists. Until then E2's sync/delete
-- code path is the referential-integrity authority (no non-NULL source_peer_id is written before E2).

CREATE TABLE provider_configs (
    id                   TEXT NOT NULL PRIMARY KEY,
    provider_type        TEXT AS net.devemperor.dictate.shared.config.ProviderType NOT NULL
                         CHECK (provider_type IN ('OPENAI','GROQ','ANTHROPIC','ELEVENLABS','OPENROUTER','CUSTOM')),
    kind                 TEXT AS net.devemperor.dictate.shared.config.ProviderKind NOT NULL DEFAULT 'LOCAL'
                         CHECK (kind IN ('LOCAL','GATEWAY')),
    label                TEXT NOT NULL,
    base_url             TEXT,
    credential_ref       TEXT,
    -- ── Envelope / provenance ──
    visibility           TEXT AS net.devemperor.dictate.shared.config.Visibility NOT NULL DEFAULT 'PRIVATE'
                         CHECK (visibility IN ('PRIVATE','SHARED')),
    subscription_mode    TEXT AS net.devemperor.dictate.shared.config.SubscriptionMode NOT NULL DEFAULT 'LOCAL'
                         CHECK (subscription_mode IN ('LOCAL','SUBSCRIBE','ONE_SHOT')),
    source_peer_id       TEXT,
    source_original_id   TEXT,
    source_original_hash TEXT,
    content_hash         TEXT NOT NULL,
    updated_at           INTEGER NOT NULL
);

CREATE TABLE model_refs (
    id                   TEXT NOT NULL PRIMARY KEY,
    provider_ref         TEXT NOT NULL,
    model_id             TEXT NOT NULL,
    function             TEXT AS net.devemperor.dictate.shared.config.ModelFunction NOT NULL
                         CHECK (function IN ('TRANSCRIPTION','COMPLETION')),
    label                TEXT,
    -- Canonical JSON (Map<String,String>) of default parameters (C1 §5.1); plain TEXT, no CHECK.
    parameter_defaults   TEXT NOT NULL DEFAULT '{}',
    -- ── Envelope / provenance ──
    visibility           TEXT AS net.devemperor.dictate.shared.config.Visibility NOT NULL DEFAULT 'PRIVATE'
                         CHECK (visibility IN ('PRIVATE','SHARED')),
    subscription_mode    TEXT AS net.devemperor.dictate.shared.config.SubscriptionMode NOT NULL DEFAULT 'LOCAL'
                         CHECK (subscription_mode IN ('LOCAL','SUBSCRIBE','ONE_SHOT')),
    source_peer_id       TEXT,
    source_original_id   TEXT,
    source_original_hash TEXT,
    content_hash         TEXT NOT NULL,
    updated_at           INTEGER NOT NULL
);
CREATE INDEX model_refs_provider_ref ON model_refs(provider_ref);

-- The shareable post-processing prompt (C1 PromptV3Entity). NO pill `type` and no keyboard `pos`
-- (F6: pills are desktop-fremd) — the desktop mirror models only the shareable AI prompt.
CREATE TABLE prompts (
    id                   TEXT NOT NULL PRIMARY KEY,
    name                 TEXT NOT NULL,
    text                 TEXT NOT NULL,
    requires_selection   INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    auto_apply           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    -- ── Envelope / provenance ──
    visibility           TEXT AS net.devemperor.dictate.shared.config.Visibility NOT NULL DEFAULT 'PRIVATE'
                         CHECK (visibility IN ('PRIVATE','SHARED')),
    subscription_mode    TEXT AS net.devemperor.dictate.shared.config.SubscriptionMode NOT NULL DEFAULT 'LOCAL'
                         CHECK (subscription_mode IN ('LOCAL','SUBSCRIBE','ONE_SHOT')),
    source_peer_id       TEXT,
    source_original_id   TEXT,
    source_original_hash TEXT,
    content_hash         TEXT NOT NULL,
    updated_at           INTEGER NOT NULL
);

CREATE TABLE profiles (
    id                       TEXT NOT NULL PRIMARY KEY,
    name                     TEXT NOT NULL,
    transcription_model_ref  TEXT,
    completion_model_ref     TEXT,
    style_prompt_mode        TEXT AS net.devemperor.dictate.shared.config.PromptSelectionMode NOT NULL DEFAULT 'PREDEFINED'
                             CHECK (style_prompt_mode IN ('NONE','PREDEFINED','CUSTOM')),
    style_prompt_custom_text TEXT NOT NULL DEFAULT '',
    system_prompt_mode       TEXT AS net.devemperor.dictate.shared.config.PromptSelectionMode NOT NULL DEFAULT 'PREDEFINED'
                             CHECK (system_prompt_mode IN ('NONE','PREDEFINED','CUSTOM')),
    system_prompt_custom_text TEXT NOT NULL DEFAULT '',
    ambiguity_mode           TEXT AS net.devemperor.dictate.shared.config.AmbiguityModeValue NOT NULL DEFAULT 'ALWAYS_INSERT'
                             CHECK (ambiguity_mode IN ('ALWAYS_INSERT','AUTO','ALWAYS_REVIEW')),
    parameter_overrides      TEXT NOT NULL DEFAULT '{}',
    -- ── Envelope / provenance ──
    visibility               TEXT AS net.devemperor.dictate.shared.config.Visibility NOT NULL DEFAULT 'PRIVATE'
                             CHECK (visibility IN ('PRIVATE','SHARED')),
    subscription_mode        TEXT AS net.devemperor.dictate.shared.config.SubscriptionMode NOT NULL DEFAULT 'LOCAL'
                             CHECK (subscription_mode IN ('LOCAL','SUBSCRIBE','ONE_SHOT')),
    source_peer_id           TEXT,
    source_original_id       TEXT,
    source_original_hash     TEXT,
    content_hash             TEXT NOT NULL,
    updated_at               INTEGER NOT NULL
);

-- A profile's ordered post-processing prompts. Row-per-position (not a JSON column) so order +
-- auto-apply stay first-class; the (profile_id, pos) PK pins the order, the CASCADE FK drops the
-- rows with the profile (C2 ProfilePromptRoomEntity parity).
CREATE TABLE profile_prompts (
    profile_id  TEXT NOT NULL,
    pos         INTEGER NOT NULL,
    prompt_ref  TEXT NOT NULL,
    auto_apply  INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    PRIMARY KEY (profile_id, pos),
    FOREIGN KEY (profile_id) REFERENCES profiles(id) ON DELETE CASCADE
);
CREATE INDEX profile_prompts_prompt_ref ON profile_prompts(prompt_ref);

-- ── devices ───────────────────────────────────────────────────────────────────────────────

deviceById:
SELECT * FROM devices WHERE device_id = ?;

allDevices:
SELECT * FROM devices ORDER BY paired_at ASC;

saveDevice:
INSERT OR REPLACE INTO devices(device_id, name, secret_hash, paired_at, last_seen_at)
VALUES (?, ?, ?, ?, ?);

touchLastSeen:
UPDATE devices SET last_seen_at = :at WHERE device_id = :deviceId;

deleteDevice:
DELETE FROM devices WHERE device_id = ?;

-- ── phone-sync history (sessions + dispatch_state) ──────────────────────────────────────────
--
-- All of these scope to `host_origin = 'PHONE_SYNC'`: they are the phone mirror, and must never see
-- (nor let the cursor advance past) a desktop-dictated session. A PHONE_SYNC session always has a
-- 1:1 dispatch_state row, so the INNER JOIN never drops one — it just widens the projection.

receivedTextById:
SELECT s.id, ds.device_id, s.final_output_text, s.created_at, ds.received_at, s.origin, ds.dispatched, ds.last_outcome
FROM sessions s
JOIN dispatch_state ds ON ds.session_id = s.id
WHERE s.host_origin = 'PHONE_SYNC' AND s.id = ?;

/**
 * The session half of the idempotent sync write. Writes the Room-parity fields with the fixed
 * PHONE_SYNC shape (type RECORDING, status COMPLETED, the received text as final output). `inserted_at`
 * mirrors the dispatch flag and — like `dispatched` in dispatch_state — never walks back: a sync that
 * believes a row was never dispatched must not erase an inserted_at a real dispatch already stamped.
 */
upsertSyncSession:
INSERT INTO sessions (id, type, created_at, status, origin, final_output_text, inserted_at,
                      host_origin, audio_file_paths, audio_duration_seconds)
VALUES (:id, 'RECORDING', :createdAt, 'COMPLETED', :origin, :finalOutputText, :insertedAt,
        'PHONE_SYNC', '[]', 0)
ON CONFLICT(id) DO UPDATE SET
    created_at        = excluded.created_at,
    origin            = excluded.origin,
    final_output_text = excluded.final_output_text,
    inserted_at       = coalesce(sessions.inserted_at, excluded.inserted_at);

/**
 * The dispatch_state half of the idempotent sync write, and the one place the "never downgrade a
 * dispatch" invariant lives. `MAX(dispatch_state.dispatched, excluded.dispatched)` is the whole
 * trick: the lazy sync mirrors the phone's view, and the phone may still believe a row was never
 * dispatched. A plain assignment would erase the fact that the text was typed into this PC's window.
 *
 * `last_outcome` is deliberately absent from the DO UPDATE list — it belongs to the *insertion*, and
 * a sync never inserts anything. Only `recordDispatch` writes it.
 */
upsertDispatchState:
INSERT INTO dispatch_state(session_id, device_id, received_at, dispatched, last_outcome)
VALUES (:sessionId, :deviceId, :receivedAt, :dispatched, NULL)
ON CONFLICT(session_id) DO UPDATE SET
    device_id   = excluded.device_id,
    received_at = excluded.received_at,
    dispatched  = MAX(dispatch_state.dispatched, excluded.dispatched);

recordDispatch:
UPDATE dispatch_state
SET received_at = :at, dispatched = 1, last_outcome = :outcome
WHERE session_id = :sessionId;

/**
 * The receive watermark. NULL row set = "I know nothing" → the phone resends from the beginning.
 *
 * JOINs dispatch_state (not just `host_origin`) so the watermark tracks only rows that still carry a
 * device binding: revoking a device cascade-deletes its dispatch_state, and — exactly as the old
 * `received_texts` cursor did before the ablation — those rows must drop out of the watermark too.
 */
selectCursor:
SELECT s.created_at, s.id
FROM sessions s
JOIN dispatch_state ds ON ds.session_id = s.id
WHERE s.host_origin = 'PHONE_SYNC'
ORDER BY s.created_at DESC, s.id DESC
LIMIT 1;

-- The history page.
--
-- instr() rather than LIKE: what a user types into a search box is a literal substring, and LIKE
-- would quietly read their wildcard characters as wildcards. An empty term matches every row —
-- instr(x, '') is 1 — which is exactly what an empty search box should do.
--
-- lower() folds ASCII case only, so "GRUSS" will not find "Grüße": a known and accepted limit of a
-- local substring search (SQLite has no Unicode case folding without an ICU build).
pageHistory:
SELECT s.id, ds.device_id, s.final_output_text, s.created_at, ds.received_at, s.origin, ds.dispatched, ds.last_outcome
FROM sessions s
JOIN dispatch_state ds ON ds.session_id = s.id
WHERE s.host_origin = 'PHONE_SYNC' AND instr(lower(s.final_output_text), lower(:term)) > 0
ORDER BY s.created_at DESC, s.id DESC
LIMIT :limit OFFSET :offset;

countHistory:
SELECT COUNT(*)
FROM sessions s
JOIN dispatch_state ds ON ds.session_id = s.id
WHERE s.host_origin = 'PHONE_SYNC' AND instr(lower(s.final_output_text), lower(:term)) > 0;

-- ── settings ──────────────────────────────────────────────────────────────────────────────

settingByKey:
SELECT value FROM settings WHERE key = ?;

putSetting:
INSERT OR REPLACE INTO settings(key, value) VALUES (?, ?);

-- ── key_command_chords ──────────────────────────────────────────────────────────────────────

chordByCommand:
SELECT * FROM key_command_chords WHERE command = ?;

allChords:
SELECT * FROM key_command_chords;

upsertChord:
INSERT OR REPLACE INTO key_command_chords(command, ctrl, shift, alt, win, vk)
VALUES (?, ?, ?, ?, ?, ?);

-- Reset = clear every override; the repo then falls back to DefaultChords for each command.
deleteAllChords:
DELETE FROM key_command_chords;

-- ── desktop-dictation writes (sessions/transcriptions/processing_steps/conversation_messages) ──
--
-- The write surface for locally-dictated sessions (host_origin = 'DESKTOP_DICTATION', §5.5). These
-- are NOT schema changes — the tables were created in D1a; adding named queries is what pulls the
-- generated ColumnAdapters for `transcriptions` / `processing_steps` / `conversation_messages` into
-- the DB constructor (D1a left them adapter-less on purpose, CompanionDatabase.kt). No .sqm needed:
-- verifyMigrations only guards CREATE statements, and these add none.

-- A fresh desktop take: origin KEYBOARD (a normal dictation), host_origin DESKTOP_DICTATION, type
-- RECORDING. Created once the mic stops, already in the pipeline (status TRANSCRIBING) — the recording
-- phase itself is transient in-memory state, only the persistable take reaches the archive.
insertDictationSession:
INSERT INTO sessions (id, type, created_at, language, audio_file_path, audio_file_paths,
                      audio_duration_seconds, status, origin, host_origin)
VALUES (:id, 'RECORDING', :createdAt, :language, :audioFilePath, :audioFilePaths,
        :durationSeconds, :status, 'KEYBOARD', 'DESKTOP_DICTATION');

updateDictationStatus:
UPDATE sessions SET status = :status WHERE id = :id;

failDictationSession:
UPDATE sessions SET status = 'FAILED', last_error_type = :errorType, last_error_message = :message
WHERE id = :id;

completeDictationSession:
UPDATE sessions SET status = 'COMPLETED', final_output_text = :finalOutputText WHERE id = :id;

stampInserted:
UPDATE sessions SET inserted_at = :insertedAt WHERE id = :id;

dictationSessionById:
SELECT * FROM sessions WHERE id = :id;

insertTranscription:
INSERT INTO transcriptions (id, session_id, version, is_current, text, model_used, provider,
                            prompt_tokens, completion_tokens, duration_ms, created_at)
VALUES (:id, :sessionId, :version, :isCurrent, :text, :modelUsed, :provider,
        :promptTokens, :completionTokens, :durationMs, :createdAt);

transcriptionsForSession:
SELECT * FROM transcriptions WHERE session_id = :sessionId ORDER BY version;

insertProcessingStep:
INSERT INTO processing_steps (id, session_id, step_type, chain_index, version, is_current, input_text,
                             output_text, model_used, provider, prompt_used, prompt_entity_id,
                             previous_step_id, previous_transcription_id, source_session_id,
                             prompt_tokens, completion_tokens, duration_ms, status, error_message,
                             created_at, assistant_message, response_format)
VALUES (:id, :sessionId, :stepType, :chainIndex, :version, :isCurrent, :inputText,
        :outputText, :modelUsed, :provider, :promptUsed, :promptEntityId,
        :previousStepId, :previousTranscriptionId, :sourceSessionId,
        :promptTokens, :completionTokens, :durationMs, :status, :errorMessage,
        :createdAt, :assistantMessage, :responseFormat);

stepsForSession:
SELECT * FROM processing_steps WHERE session_id = :sessionId ORDER BY chain_index, version;

insertConversationMessage:
INSERT INTO conversation_messages (id, session_id, turn_index, seq, role, content, step_id, created_at)
VALUES (:id, :sessionId, :turnIndex, :seq, :role, :content, :stepId, :createdAt);

messagesForSession:
SELECT * FROM conversation_messages WHERE session_id = :sessionId ORDER BY seq;

-- The transcription-only S2 take of a review re-dictate (desktop-host.md §8.3 step 1). A COMPLETED
-- RECORDING with origin REVIEW_REFINEMENT, hung off the reviewed session via parent_session_id — the
-- audio/transcript of the spoken refinement live in their own session; the continuation TURN it
-- produces is appended to the parent (reviewed) session, not here.
insertRefinementSession:
INSERT INTO sessions (id, type, created_at, language, audio_file_path, audio_file_paths,
                      audio_duration_seconds, status, origin, host_origin, parent_session_id)
VALUES (:id, 'RECORDING', :createdAt, :language, :audioFilePath, :audioFilePaths,
        :durationSeconds, 'COMPLETED', 'REVIEW_REFINEMENT', 'DESKTOP_DICTATION', :parentSessionId);

-- ── config entities (D3, §9) ──────────────────────────────────────────────────────────────────
--
-- CRUD over the shareable config mirror. Reads order by updated_at DESC (most-recently-touched
-- first) for the management screens; writes are INSERT OR REPLACE upserts keyed on the entity id.

allProviderConfigs:
SELECT * FROM provider_configs ORDER BY updated_at DESC;

providerConfigById:
SELECT * FROM provider_configs WHERE id = :id;

upsertProviderConfig:
INSERT OR REPLACE INTO provider_configs (id, provider_type, kind, label, base_url, credential_ref,
                      visibility, subscription_mode, source_peer_id, source_original_id,
                      source_original_hash, content_hash, updated_at)
VALUES (:id, :providerType, :kind, :label, :baseUrl, :credentialRef,
        :visibility, :subscriptionMode, :sourcePeerId, :sourceOriginalId,
        :sourceOriginalHash, :contentHash, :updatedAt);

deleteProviderConfig:
DELETE FROM provider_configs WHERE id = :id;

allModelRefs:
SELECT * FROM model_refs ORDER BY updated_at DESC;

modelRefsByFunction:
SELECT * FROM model_refs WHERE function = :function ORDER BY updated_at DESC;

modelRefById:
SELECT * FROM model_refs WHERE id = :id;

upsertModelRef:
INSERT OR REPLACE INTO model_refs (id, provider_ref, model_id, function, label, parameter_defaults,
                      visibility, subscription_mode, source_peer_id, source_original_id,
                      source_original_hash, content_hash, updated_at)
VALUES (:id, :providerRef, :modelId, :function, :label, :parameterDefaults,
        :visibility, :subscriptionMode, :sourcePeerId, :sourceOriginalId,
        :sourceOriginalHash, :contentHash, :updatedAt);

deleteModelRef:
DELETE FROM model_refs WHERE id = :id;

allPrompts:
SELECT * FROM prompts ORDER BY updated_at DESC;

promptById:
SELECT * FROM prompts WHERE id = :id;

upsertPrompt:
INSERT OR REPLACE INTO prompts (id, name, text, requires_selection, auto_apply,
                      visibility, subscription_mode, source_peer_id, source_original_id,
                      source_original_hash, content_hash, updated_at)
VALUES (:id, :name, :text, :requiresSelection, :autoApply,
        :visibility, :subscriptionMode, :sourcePeerId, :sourceOriginalId,
        :sourceOriginalHash, :contentHash, :updatedAt);

deletePrompt:
DELETE FROM prompts WHERE id = :id;

allProfiles:
SELECT * FROM profiles ORDER BY updated_at DESC;

profileById:
SELECT * FROM profiles WHERE id = :id;

upsertProfile:
INSERT OR REPLACE INTO profiles (id, name, transcription_model_ref, completion_model_ref,
                      style_prompt_mode, style_prompt_custom_text, system_prompt_mode,
                      system_prompt_custom_text, ambiguity_mode, parameter_overrides,
                      visibility, subscription_mode, source_peer_id, source_original_id,
                      source_original_hash, content_hash, updated_at)
VALUES (:id, :name, :transcriptionModelRef, :completionModelRef,
        :stylePromptMode, :stylePromptCustomText, :systemPromptMode,
        :systemPromptCustomText, :ambiguityMode, :parameterOverrides,
        :visibility, :subscriptionMode, :sourcePeerId, :sourceOriginalId,
        :sourceOriginalHash, :contentHash, :updatedAt);

deleteProfile:
DELETE FROM profiles WHERE id = :id;

promptsForProfile:
SELECT * FROM profile_prompts WHERE profile_id = :profileId ORDER BY pos;

insertProfilePrompt:
INSERT OR REPLACE INTO profile_prompts (profile_id, pos, prompt_ref, auto_apply)
VALUES (:profileId, :pos, :promptRef, :autoApply);

deleteProfilePrompts:
DELETE FROM profile_prompts WHERE profile_id = :profileId;
