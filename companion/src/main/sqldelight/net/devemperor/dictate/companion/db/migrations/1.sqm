-- v1 -> v2: configurable command -> chord mapping for /v1/input (D6, §5.4).
--
-- The CREATE below must stay byte-identical to the table in Companion.sq — `verifyMigrations`
-- replays this against the checked-in databases/1.db snapshot and compares the result with the
-- current .sq, so any drift fails the build.
--
-- The seed VK values mirror DefaultChords (the Kotlin SSoT); ChordSeedParityTest pins the two
-- against each other so a change on one side that forgets the other cannot merge. A fresh install
-- (schema.create, no migration) skips this seed, but the repository falls back to DefaultChords for
-- any missing row, so both paths behave identically.
CREATE TABLE key_command_chords (
    command TEXT AS net.devemperor.dictate.companion.domain.model.KeyCommand NOT NULL PRIMARY KEY
            CHECK (command IN ('BACKSPACE','ENTER','SPACE','CURSOR_LEFT','CURSOR_RIGHT','CURSOR_WORD_SELECT_BACK','CURSOR_WORD_SELECT_FORWARD','SELECT_ALL','CUT','COPY','PASTE','UNDO','REDO')),
    ctrl    INTEGER AS kotlin.Boolean NOT NULL CHECK (ctrl IN (0,1)),
    shift   INTEGER AS kotlin.Boolean NOT NULL CHECK (shift IN (0,1)),
    alt     INTEGER AS kotlin.Boolean NOT NULL CHECK (alt IN (0,1)),
    win     INTEGER AS kotlin.Boolean NOT NULL CHECK (win IN (0,1)),
    vk      INTEGER NOT NULL CHECK (vk BETWEEN 1 AND 254)
);

INSERT INTO key_command_chords(command, ctrl, shift, alt, win, vk) VALUES
    ('BACKSPACE', 0, 0, 0, 0, 8),
    ('ENTER', 0, 0, 0, 0, 13),
    ('SPACE', 0, 0, 0, 0, 32),
    ('CURSOR_LEFT', 0, 0, 0, 0, 37),
    ('CURSOR_RIGHT', 0, 0, 0, 0, 39),
    ('CURSOR_WORD_SELECT_BACK', 1, 1, 0, 0, 37),
    ('CURSOR_WORD_SELECT_FORWARD', 1, 1, 0, 0, 39),
    ('SELECT_ALL', 1, 0, 0, 0, 65),
    ('CUT', 1, 0, 0, 0, 88),
    ('COPY', 1, 0, 0, 0, 67),
    ('PASTE', 1, 0, 0, 0, 86),
    ('UNDO', 1, 0, 0, 0, 90),
    ('REDO', 1, 0, 0, 0, 89);
